# Public values only. Never put secret/service_role keys here or in NEXT_PUBLIC_*.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Enable only after Google OAuth and Supabase redirect URLs are configured.
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=false
# Public GA4 web stream ID. Analytics loads only after explicit website consent.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
